# Copy to deploy/.env on the server and fill in every value. Never commit the real file.

# The address visitors' browsers load the assistant from (an A record pointing at the server).
API_DOMAIN=voice.futuretecinfo.com

# Two different long random passwords (generate each with: openssl rand -hex 24)
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=

# Signs visitor chat sessions (generate with: openssl rand -hex 32)
WIDGET_SIGNING_KEY=

# Fixed settings for the demo server
APP_ENV=production
DEV_AUTH_ENABLED=false
ADMIN_API_ENABLED=false
ALLOW_MANUAL_DOMAIN_VERIFICATION=false

# Answers. Create a key at https://console.anthropic.com/ . Without one the assistant still
# works but quotes the best matching page instead of writing an answer.
ANTHROPIC_API_KEY=
DAILY_AI_MESSAGE_CAP=300

# Email that carries call-back requests. Use the SMTP details from your email provider
# (for example Google Workspace, Microsoft 365, Zoho, or your hosting company's mail server).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_USE_SSL=false
MAIL_FROM=FutureTec Assistant <no-reply@futuretecinfo.com>

# Link to your privacy policy page (shown next to the consent tick-box in a later release)
PRIVACY_URL=https://futuretecinfo.com/privacy
