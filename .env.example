APP_ENV=development
# Runtime role (unprivileged). Migrations use MIGRATION_DATABASE_URL (owner).
DATABASE_URL=postgresql+psycopg://concierge_app:concierge_app@localhost:5432/concierge
MIGRATION_DATABASE_URL=postgresql+psycopg://concierge:concierge@localhost:5432/concierge
REDIS_URL=redis://localhost:6379/0
DEV_AUTH_ENABLED=true
DEV_AUTH_SECRET=local-development-only
# Required when DEV_AUTH_ENABLED=false
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
LOG_LEVEL=INFO
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WIDGET_URL=http://localhost:5173/widget.js
OPENAI_API_KEY=
AWS_REGION=eu-west-2
